# Copy to .env when using Docker Compose (optional — compose has defaults)
# Local-only dev without Docker: keep POSTGRES_HOST=localhost in .env

DOCKER_POSTGRES_USER=eduspark
DOCKER_POSTGRES_PASSWORD=eduspark
DOCKER_POSTGRES_DB=eduspark_syria
# Use 5433 if local PostgreSQL already uses 5432
POSTGRES_PUBLISH_PORT=5432

JWT_SECRET=change-me-to-a-long-random-secret
# Claude LLM (primary — all text/JSON generation)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
LLM_PROVIDER=claude
# Gemini — STT fallbacks only
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

ENABLE_PGVECTOR=false
ENABLE_EMBEDDINGS=false
ENABLE_FAISS=true
HF_HOME=/app/uploads/model-cache/huggingface
HUGGINGFACE_HUB_CACHE=/app/uploads/model-cache/huggingface/hub
SENTENCE_TRANSFORMERS_HOME=/app/uploads/model-cache/sentence-transformers
ENABLE_WHISPER=true
WHISPER_MODEL=turbo
VIDEO_TRANSCRIPTION_PROVIDER=deepgram
VIDEO_TRANSCRIPTION_ALLOW_WHISPER_FALLBACK=false
VIDEO_TRANSCRIPTION_ALLOW_GEMINI_FALLBACK=false
LESSON_VIDEO_WHISPER_LANGUAGE=ar
LESSON_VIDEO_FASTER_WHISPER_MODEL=large-v3-turbo
LESSON_VIDEO_GEMINI_TIMEOUT_SECONDS=600
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=ar-SY
DEEPGRAM_STT_TIMEOUT_SECONDS=300
DEEPGRAM_STT_SMART_FORMAT=true
ENABLE_TTS=false
TTS_PROVIDER=elevenlabs
TTS_REQUEST_TIMEOUT_SECONDS=120
TTS_LANGUAGE=ar
TTS_ALLOWED_LANGUAGES=ar,en,fr
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
LANGUAGE_TTS_PROVIDER=supertonic
LANGUAGE_SUPERTONIC_VOICE=M1
LANGUAGE_SUPERTONIC_AUTO_DOWNLOAD=true

# Browser → Vite on host; Vite proxy → backend container
VITE_API_URL=http://127.0.0.1:8000
