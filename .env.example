# EduSpark — local development (copy to .env in project root)

# PostgreSQL on your machine (not Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use your real PostgreSQL login (common: user postgres + your install password)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=eduspark_syria

# Or, after running setup_local_db.sql:
# POSTGRES_USER=eduspark
# POSTGRES_PASSWORD=eduspark

# Leave empty — URLs are built from POSTGRES_* automatically
# Runtime (FastAPI): postgresql+asyncpg://...
DATABASE_URL=
# Migrations (Alembic): postgresql+psycopg2://... (auto-derived if empty)
SYNC_DATABASE_URL=
DATABASE_URL_SYNC=

# File uploads (default: backend/uploads)
UPLOAD_DIR=
# Max PDF upload size in bytes (default: 500 MB)
MAX_PDF_BYTES=524288000

JWT_SECRET=change-me-to-a-long-random-secret
# Claude LLM (primary — all text/JSON generation)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
LLM_PROVIDER=claude

# Gemini — STT fallbacks only (student chat, teacher/lesson audio/video)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
DEBUG=true
ENABLE_PGVECTOR=false
ENABLE_EMBEDDINGS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Transactional email (Resend) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=EduSpark <onboarding@resend.dev>

# Automated test users (scripts only — never use real accounts in tests):
#   python scripts/seed_test_users.py --list

# Two-factor authentication (email OTP)
TWO_FACTOR_CODE_EXPIRE_MINUTES=10
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RESEND_COOLDOWN_SECONDS=60
TWO_FACTOR_MAX_RESENDS=3

# Notebook AI pipeline
# Production-grade lesson RAG: local BGE-M3 embeddings + FAISS semantic search.
# Set ENABLE_FAISS=false only for very light local runs without model downloads.
HF_HOME=
HUGGINGFACE_HUB_CACHE=
SENTENCE_TRANSFORMERS_HOME=
ENABLE_FAISS=true
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_INDEX_DIR=
ENABLE_WHISPER=true
WHISPER_MODEL=turbo
# If the faster-whisper model download from Hugging Face is slow/unreliable on first run,
# point this at a local ctranslate2 model folder instead (config.json + model.bin + vocabulary.json)
# to skip the download entirely. Leave empty to download normally.
WHISPER_MODEL_PATH=
LESSON_VIDEO_WHISPER_LANGUAGE=ar
LESSON_VIDEO_FASTER_WHISPER_MODEL=large-v3-turbo
LESSON_VIDEO_GEMINI_TIMEOUT_SECONDS=600
LLM_PROVIDER=claude
# Optional local dev fallback (set LLM_PROVIDER=ollama and run Ollama):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3
ENABLE_TTS=false
TTS_PROVIDER=elevenlabs
TTS_REQUEST_TIMEOUT_SECONDS=120
TTS_LANGUAGE=ar
TTS_ALLOWED_LANGUAGES=ar,en,fr
TTS_OUTPUT_DIR=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
LANGUAGE_TTS_PROVIDER=supertonic
LANGUAGE_SUPERTONIC_VOICE=M1
LANGUAGE_SUPERTONIC_AUTO_DOWNLOAD=true

# Language speaking conversation (English-learning module)
LANGUAGE_CONVERSATION_MOCK_AI=false
OPENAI_API_KEY=
LANGUAGE_STT_PROVIDER=openai
LANGUAGE_STT_MODEL=gpt-4o-transcribe
LANGUAGE_STT_ALLOW_WHISPER_FALLBACK=true
GENAI_EXAM_MAX_AUDIO_MB=10

# Student lesson voice chat STT (Deepgram Nova — Arabic)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

LANGUAGE_CONVERSATION_WHISPER_MODEL=small.en
LANGUAGE_CONVERSATION_WHISPER_COMPUTE_TYPE=float32
LANGUAGE_CONVERSATION_WHISPER_BEAM_SIZE=5
LANGUAGE_CONVERSATION_WHISPER_VAD=false
LANGUAGE_CONVERSATION_ASYNC_TTS=true

# Speaking assessment evidence pipeline (config only — no runtime wired yet).
# Real secrets belong ONLY in your local ignored .env or a deployment secret manager —
# never in this file, never in code/tests/docs, never committed.
SPEAKING_TRANSCRIPTION_PROVIDER=openai
SPEAKING_TRANSCRIPTION_TIMEOUT_SECONDS=120

# Pronunciation evidence (wav2vec2 | mock)
SPEAKING_PRONUNCIATION_PROVIDER=wav2vec2
SPEAKING_PRONUNCIATION_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
SPEAKING_PRONUNCIATION_TIMEOUT_SECONDS=120
SPEAKING_PRONUNCIATION_MIN_CONFIDENCE=0.15

# Prosody/delivery evidence (acoustic | hume | mock) — MVP must stay "acoustic" (local,
# numpy-derived, no external API). HUME_API_KEY is reserved/optional, not used while
# SPEAKING_PROSODY_PROVIDER=acoustic.
SPEAKING_PROSODY_PROVIDER=acoustic
HUME_API_KEY=replace_me
SPEAKING_PROSODY_TIMEOUT_SECONDS=120
SPEAKING_PROSODY_POLL_INTERVAL_SECONDS=2

# Hume EVI live-conversation runtime — for a FUTURE live-conversation feature, not the
# current 3-turn placement flow. HUME_SECRET_KEY is server-side only (mints short-lived
# browser access tokens) and must never be exposed to the frontend.
SPEAKING_LIVE_CONVERSATION_PROVIDER=hume_evi
HUME_SECRET_KEY=replace_me
HUME_EVI_CONFIG_ID=replace_me
SPEAKING_EVI_TIMEOUT_SECONDS=60
SPEAKING_EVI_RECONNECT_ENABLED=false
SPEAKING_EVI_MAX_TURN_SECONDS=120
SPEAKING_EVI_MAX_TURN_BYTES=25000000
SPEAKING_EVI_TOKEN_TTL_SECONDS=1500

# Frontend → local API (used by Vite proxy target)
VITE_API_URL=http://127.0.0.1:8000

# Dev: use Vite proxy (/api) — avoids CORS. Set true to call API directly:
# VITE_API_DIRECT=true

# Set true only to use dummy data without backend
# VITE_USE_MOCK=true

# --- Docker Compose (optional) ---
# cp .env.docker.example .env  or set POSTGRES_PUBLISH_PORT=5433 if 5432 is busy
# See DOCKER.md
