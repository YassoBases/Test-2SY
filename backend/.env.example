# Prefer a single .env in project root (../.env).
# These match local PostgreSQL defaults:

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eduspark
POSTGRES_PASSWORD=eduspark
POSTGRES_DB=eduspark_syria

# Production: false (schema via Alembic only). Legacy dev DBs: true for column patches.
APPLY_LEGACY_SCHEMA_PATCHES=false

# Set true only after installing pgvector on PostgreSQL
ENABLE_PGVECTOR=false
ENABLE_EMBEDDINGS=false

# Production-grade lesson RAG: local BGE-M3 embeddings + FAISS semantic search.
# Set ENABLE_FAISS=false only for very light local runs without model downloads.
HF_HOME=
HUGGINGFACE_HUB_CACHE=
SENTENCE_TRANSFORMERS_HOME=
ENABLE_FAISS=true
EMBEDDING_MODEL=BAAI/bge-m3
ENABLE_WHISPER=true
WHISPER_MODEL=turbo
# Lesson video STT (Arabic): faster-whisper large-v3-turbo -> Gemini (600s)
LESSON_VIDEO_WHISPER_LANGUAGE=ar
LESSON_VIDEO_FASTER_WHISPER_MODEL=large-v3-turbo
LESSON_VIDEO_GEMINI_TIMEOUT_SECONDS=600
# Claude LLM (primary — all text/JSON generation)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
LLM_PROVIDER=claude

# Gemini — STT fallbacks only (student chat, teacher/lesson audio/video)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Optional local dev fallback (set LLM_PROVIDER=ollama and run Ollama):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=EduSpark <onboarding@resend.dev>
ENABLE_TTS=false
TTS_PROVIDER=elevenlabs
LANGUAGE_TTS_PROVIDER=supertonic
LANGUAGE_SUPERTONIC_VOICE=M1
LANGUAGE_SUPERTONIC_AUTO_DOWNLOAD=true
OPENAI_API_KEY=
# M12 — Scene Practice voice (OpenAI TTS only; Claude owns all reasoning)
SPEAKING_TTS_MODEL=gpt-4o-mini-tts
SPEAKING_TTS_VOICE=verse
SPEAKING_TTS_TIMEOUT_SECONDS=30
LANGUAGE_STT_PROVIDER=openai
LANGUAGE_STT_MODEL=gpt-4o-transcribe
LANGUAGE_STT_ALLOW_WHISPER_FALLBACK=true
GENAI_EXAM_MAX_AUDIO_MB=10

# Student lesson voice chat STT (Deepgram Nova — Arabic)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

# Speaking assessment evidence pipeline (config only — no runtime wired yet).
# Real secrets belong ONLY in your local ignored .env or a deployment secret manager —
# never in this file, never in code/tests/docs, never committed.
SPEAKING_TRANSCRIPTION_PROVIDER=openai
SPEAKING_TRANSCRIPTION_TIMEOUT_SECONDS=120

# Pronunciation evidence (wav2vec2 | mock)
SPEAKING_PRONUNCIATION_PROVIDER=wav2vec2
SPEAKING_PRONUNCIATION_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
SPEAKING_PRONUNCIATION_TIMEOUT_SECONDS=120
SPEAKING_PRONUNCIATION_MIN_CONFIDENCE=0.15

# Prosody/delivery evidence (acoustic | hume | mock) — MVP must stay "acoustic" (local,
# numpy-derived, no external API). HUME_API_KEY is reserved/optional, not used while
# SPEAKING_PROSODY_PROVIDER=acoustic.
SPEAKING_PROSODY_PROVIDER=acoustic
HUME_API_KEY=replace_me
SPEAKING_PROSODY_TIMEOUT_SECONDS=120
SPEAKING_PROSODY_POLL_INTERVAL_SECONDS=2

# Hume EVI live-conversation runtime — for a FUTURE live-conversation feature, not the
# current 3-turn placement flow. HUME_SECRET_KEY is server-side only (mints short-lived
# browser access tokens) and must never be exposed to the frontend.
SPEAKING_LIVE_CONVERSATION_PROVIDER=hume_evi
HUME_SECRET_KEY=replace_me
HUME_EVI_CONFIG_ID=replace_me
SPEAKING_EVI_TIMEOUT_SECONDS=60
SPEAKING_EVI_TOKEN_TTL_SECONDS=1500

# Speaking live transcript preview (MVP, display-only; UX only, never the grading source of
# truth). Disabled by default. Mints short-lived OpenAI Realtime client secrets using the
# OPENAI_API_KEY above -- that real key is never exposed to the frontend, only the ephemeral,
# transcription-scoped secret this feature mints per recording.
SPEAKING_LIVE_TRANSCRIPTION_ENABLED=false
SPEAKING_LIVE_TRANSCRIPTION_PROVIDER=openai_realtime
SPEAKING_LIVE_TRANSCRIPTION_MODEL=gpt-realtime-whisper
SPEAKING_LIVE_TRANSCRIPTION_TOKEN_TTL_SECONDS=60
# Grammar spine (G0+) — shared engine for all four skills; NOT a fifth Official CEFR skill
LANG_GRAMMAR_ENGINE_ENABLED=false
LANG_GRAMMAR_ENGINE_SELECT=false
LANG_GRAMMAR_ACTIVITY_PROVIDER=template
LANG_GRAMMAR_ACTIVITY_SPEC_STRICT=true
LANG_GRAMMAR_SKILL_EXECUTOR_ENABLED=false
LANG_GRAMMAR_SKILL_EXECUTOR_STRICT=true
LANG_GRAMMAR_SKILL_EXECUTION_ENGINE_ENABLED=true
LANG_GRAMMAR_SPEAKING_DOMAIN_ENABLED=true
LANG_GRAMMAR_ACTIVITY_AUTHORING_ENABLED=true
LANG_GRAMMAR_ACTIVITY_AUTHORING_STRICT=true
LANG_GRAMMAR_LLM_AUTHORING_ENABLED=false
LANG_GRAMMAR_LLM_AUTHORING_PROVIDER=claude
LANG_GRAMMAR_LLM_AUTHORING_FALLBACK=true
LANG_GRAMMAR_LLM_AUTHORING_MAX_RETRIES=3
LANG_GRAMMAR_LLM_AUTHORING_TIMEOUT_SECONDS=60
LANG_GRAMMAR_EVALUATION_ENABLED=true
LANG_GRAMMAR_EVALUATION_STRICT=true
LANG_GRAMMAR_PIPELINE_ENABLED=false
LANG_GRAMMAR_PIPELINE_STRICT=true
LANG_GRAMMAR_MODULE_ENABLED=false
# Adaptive Learning Intelligence (Phase 2) — personalization HOW only; never curriculum.
LANG_ADAPTIVE_INTELLIGENCE_ENABLED=false
LANG_ADAPTIVE_PROFILE_PERSIST=true
# AI Tutor Foundation (Wave E1) — orchestration only; never mastery/progression writes.
LANG_AI_TUTOR_ENABLED=false
LANG_AI_TUTOR_MEMORY_PERSIST=true
LANG_AI_TUTOR_LLM_ENABLED=true
# Conversational Coaching (Wave E2) — requires AI Tutor Foundation.
LANG_AI_TUTOR_COACHING_ENABLED=false
LANG_AI_TUTOR_COACHING_PERSIST=true
LANG_AI_TUTOR_COACHING_LLM_ENABLED=true
# Autonomous AI Teacher (Phase F) — session orchestration; never educational writes.
LANG_AI_TEACHER_ENABLED=false
LANG_AI_TEACHER_PERSIST=true
# Optional override for tests — default is backend/curriculum/
# LANG_GRAMMAR_CURRICULUM_ROOT=

# Student lesson voice chat STT (Deepgram Nova — Arabic)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
