# Prefer a single .env in project root (../.env).
# These match local PostgreSQL defaults:

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eduspark
POSTGRES_PASSWORD=eduspark
POSTGRES_DB=eduspark_syria

# Production: false (schema via Alembic only). Legacy dev DBs: true for column patches.
APPLY_LEGACY_SCHEMA_PATCHES=false

# Set true only after installing pgvector on PostgreSQL
ENABLE_PGVECTOR=false
ENABLE_EMBEDDINGS=false

# Production-grade lesson RAG: local BGE-M3 embeddings + FAISS semantic search.
# Set ENABLE_FAISS=false only for very light local runs without model downloads.
HF_HOME=
HUGGINGFACE_HUB_CACHE=
SENTENCE_TRANSFORMERS_HOME=
ENABLE_FAISS=true
EMBEDDING_MODEL=BAAI/bge-m3
ENABLE_WHISPER=true
WHISPER_MODEL=turbo
# Lesson video STT (Arabic): faster-whisper large-v3-turbo -> Gemini (600s)
LESSON_VIDEO_WHISPER_LANGUAGE=ar
LESSON_VIDEO_FASTER_WHISPER_MODEL=large-v3-turbo
LESSON_VIDEO_GEMINI_TIMEOUT_SECONDS=600
# Claude LLM (primary — all text/JSON generation)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
LLM_PROVIDER=claude

# Gemini — STT fallbacks only (student chat, teacher/lesson audio/video)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Optional local dev fallback (set LLM_PROVIDER=ollama and run Ollama):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=EduSpark <onboarding@resend.dev>
ENABLE_TTS=false
TTS_PROVIDER=elevenlabs
LANGUAGE_TTS_PROVIDER=supertonic
LANGUAGE_SUPERTONIC_VOICE=M1
LANGUAGE_SUPERTONIC_AUTO_DOWNLOAD=true
OPENAI_API_KEY=
LANGUAGE_STT_PROVIDER=openai
LANGUAGE_STT_MODEL=gpt-4o-transcribe
LANGUAGE_STT_ALLOW_WHISPER_FALLBACK=true
GENAI_EXAM_MAX_AUDIO_MB=10

# Student lesson voice chat STT (Deepgram Nova — Arabic)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

# Speaking assessment evidence pipeline (config only — no runtime wired yet).
# Real secrets belong ONLY in your local ignored .env or a deployment secret manager —
# never in this file, never in code/tests/docs, never committed.
SPEAKING_TRANSCRIPTION_PROVIDER=openai
SPEAKING_TRANSCRIPTION_TIMEOUT_SECONDS=120

# Pronunciation evidence (wav2vec2 | mock)
SPEAKING_PRONUNCIATION_PROVIDER=wav2vec2
SPEAKING_PRONUNCIATION_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
SPEAKING_PRONUNCIATION_TIMEOUT_SECONDS=120
SPEAKING_PRONUNCIATION_MIN_CONFIDENCE=0.15

# Prosody/delivery evidence (acoustic | hume | mock) — MVP must stay "acoustic" (local,
# numpy-derived, no external API). HUME_API_KEY is reserved/optional, not used while
# SPEAKING_PROSODY_PROVIDER=acoustic.
SPEAKING_PROSODY_PROVIDER=acoustic
HUME_API_KEY=replace_me
SPEAKING_PROSODY_TIMEOUT_SECONDS=120
SPEAKING_PROSODY_POLL_INTERVAL_SECONDS=2

# Hume EVI live-conversation runtime — for a FUTURE live-conversation feature, not the
# current 3-turn placement flow. HUME_SECRET_KEY is server-side only (mints short-lived
# browser access tokens) and must never be exposed to the frontend.
SPEAKING_LIVE_CONVERSATION_PROVIDER=hume_evi
HUME_SECRET_KEY=replace_me
HUME_EVI_CONFIG_ID=replace_me
SPEAKING_EVI_TIMEOUT_SECONDS=60
SPEAKING_EVI_RECONNECT_ENABLED=false
SPEAKING_EVI_MAX_TURN_SECONDS=120
SPEAKING_EVI_MAX_TURN_BYTES=25000000
SPEAKING_EVI_TOKEN_TTL_SECONDS=1500

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
